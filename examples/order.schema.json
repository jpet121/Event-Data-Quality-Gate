{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alderquay:order.created:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "occurred_at", "currency", "items", "total_minor"],
  "properties": {
    "order_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "occurred_at": {"type": "string"},
    "currency": {"type": "string", "const": "USD"},
    "total_minor": {"type": "integer", "minimum": 0, "maximum": 500000000000000},
    "items": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["line_id", "sku", "quantity", "unit_price_minor"],
        "properties": {
          "line_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "sku": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 10000},
          "unit_price_minor": {"type": "integer", "minimum": 0, "maximum": 100000000}
        }
      }
    }
  }
}
